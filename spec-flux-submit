#!/bin/bash
set -euo pipefail

job_dir="${WORKLOAD_JOB_DIR:?Missing replay job directory}"
expected_procs="${WORKLOAD_PROCS:?Missing replay rank count}"

if (( $# < 2 )) || [[ "$1" != "$expected_procs" ]]; then
    echo "Expected $expected_procs ranks followed by the SPEC command" >&2
    exit 2
fi

procs="$1"
shift

# Refuse a second submission attempt for this CSV row.
mkdir -- "$job_dir/.submit-attempt"

options=(
    "--ntasks=$procs"
    "--job-name=${job_dir##*/}"
    "--cwd=$PWD"
    "--output=$job_dir/stdout"
    "--error=$job_dir/stderr"
)

# if [[ -f "/proc/$$/fd/0" ]]; then
#     input_file="$(readlink -- "/proc/$$/fd/0")"
#     options+=("--input=$input_file")
# fi
options+=("--input=/dev/null")

if [[ -n "${SPECHPC_FLUX_PMI:-}" ]]; then
    options+=(-o "pmi=$SPECHPC_FLUX_PMI")
fi

job_id="$(flux submit "${options[@]}" "$@" 2>"$job_dir/submit.err")"
[[ -n "$job_id" ]]
printf '%s\n' "$job_id" > "$job_dir/flux_job_id"
